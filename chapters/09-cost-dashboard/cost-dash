#!/usr/bin/env python3
# cost-dash: the chapter 9 cost dashboard (Project #8). Python 3.9+, standard library only.
#
# The book describes this tool and prints a parser sketch ("The poll loop"). Three lines of that
# sketch do not run on a current machine, so this file differs from it here:
#   - `-> dict | None` fails on Python 3.9; this file uses Optional.
#   - `started_at[:8].replace("-W", "-W")` gives '2026-05-', not '2026-W19'; this file
#     uses date.isocalendar().
#   - opencode keeps sessions in SQLite (opencode.db), not one JSON file per session, and
#     records model, agent, tokens and cost on each assistant MESSAGE. One session can hold
#     the orchestrator and the fixer, so a row here is one (session, agent, model), and the
#     book's `sessions` table gets an `agent` column and a three-part key.
# Cost is the number opencode recorded on each message. Nothing here computes a price.
import argparse, csv, datetime as dt, json, os, sqlite3, sys
from pathlib import Path
from typing import Iterable, List, Optional

HOME = Path.home()
XDG_DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
OPENCODE_DB = XDG_DATA / "opencode/opencode.db"
DB_PATH = HOME / ".local/share/opencode-dashboard/cost.db"
REPORT_DIR = HOME / "Documents/opencode-weekly"
UNKNOWN = "unknown, you must observe this"

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions (
  session_id TEXT NOT NULL,
  agent TEXT NOT NULL,             -- added: one session can hold several agents
  started_at TEXT NOT NULL,        -- ISO 8601, local time
  ended_at TEXT NOT NULL,
  provider TEXT NOT NULL,
  model TEXT NOT NULL,             -- provider/model, as in cost-log.csv
  input_tokens INTEGER NOT NULL,
  output_tokens INTEGER NOT NULL,  -- output + reasoning tokens
  cache_hit_tokens INTEGER DEFAULT 0,
  cost_usd REAL NOT NULL,
  iso_week TEXT NOT NULL,          -- '2026-W19' for grouping
  task_class TEXT,                 -- you tag it: refactor / greenfield / debug
  PRIMARY KEY (session_id, agent, model)
);"""


def iso_week(day: dt.date) -> str:
    y, w, _ = day.isocalendar()
    return "%d-W%02d" % (y, w)


def stamp(ms: Optional[int] = None) -> str:
    """epoch milliseconds (default: now) -> local ISO 8601"""
    t = dt.datetime.now() if ms is None else dt.datetime.fromtimestamp(ms / 1000)
    return t.astimezone().isoformat(timespec="seconds")


def rows_from_messages(pairs: Iterable) -> List[dict]:
    """pairs: (session_id, message dict). Returns one row per (session, agent, model)."""
    rows = {}
    for sid, m in pairs:
        if m.get("role") != "assistant" or not m.get("modelID"):
            continue
        t, tok = m.get("time") or {}, m.get("tokens") or {}
        key = (sid, m.get("agent") or m.get("mode") or "unknown", "%s/%s" % (m.get("providerID"), m["modelID"]))
        r = rows.setdefault(key, {"session_id": key[0], "agent": key[1], "model": key[2],
                                  "provider": m.get("providerID") or "unknown", "first": None, "last": 0,
                                  "input_tokens": 0, "output_tokens": 0, "cache_hit_tokens": 0, "cost_usd": 0.0})
        start = t.get("created") or 0
        r["first"] = start if r["first"] is None else min(r["first"], start)
        r["last"] = max(r["last"], t.get("completed") or start)
        r["input_tokens"] += tok.get("input") or 0
        r["output_tokens"] += (tok.get("output") or 0) + (tok.get("reasoning") or 0)
        r["cache_hit_tokens"] += (tok.get("cache") or {}).get("read") or 0
        r["cost_usd"] += float(m.get("cost") or 0)
    out = []
    for r in rows.values():
        first, last = r.pop("first"), r.pop("last")
        r.update(started_at=stamp(first), ended_at=stamp(last),
                 iso_week=iso_week(dt.datetime.fromtimestamp(first / 1000).date()))
        out.append(r)
    return out


def read_opencode_db(path: Path) -> List[dict]:
    if not path.exists():
        sys.exit("cost-dash: no opencode database at %s\n"
                 "  run `opencode db path` to find yours, then pass --opencode-db PATH" % path)
    con = sqlite3.connect("file:%s?mode=ro" % path, uri=True)   # read-only: never touches your sessions
    try:
        cur = con.execute("SELECT session_id, data FROM message")
        return rows_from_messages((sid, json.loads(d)) for sid, d in cur)
    finally:
        con.close()


def read_export(path: Path) -> List[dict]:
    """One `opencode export <sessionID>` file: {info, messages: [{info, parts}]}."""
    data = json.loads(path.read_text())
    sid = data["info"]["id"]
    return rows_from_messages((sid, m.get("info", m)) for m in data.get("messages", []))


def open_store(args) -> sqlite3.Connection:
    Path(args.db).parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(args.db))
    con.row_factory = sqlite3.Row
    con.executescript(SCHEMA)
    if args.cmd == "reset":   # clearing the cooldown must work even with no opencode data
        args.export_session = None
        return con
    rows = read_export(Path(args.export)) if args.export else read_opencode_db(Path(args.opencode_db))
    args.export_session = rows[0]["session_id"] if args.export and rows else None
    cols = ["session_id", "agent", "started_at", "ended_at", "provider", "model", "input_tokens",
            "output_tokens", "cache_hit_tokens", "cost_usd", "iso_week"]
    # upsert keeps the task_class you tagged; the sketch's INSERT OR REPLACE would wipe it on every sync
    con.executemany(
        "INSERT INTO sessions (%s) VALUES (%s) ON CONFLICT(session_id, agent, model) DO UPDATE SET %s"
        % (",".join(cols), ",".join("?" * len(cols)), ",".join("%s=excluded.%s" % (c, c) for c in cols[2:])),
        [tuple(r[c] for c in cols) for r in rows])
    con.commit()
    return con


def today_cost(con, day: dt.date) -> float:
    return con.execute("SELECT COALESCE(SUM(cost_usd),0) FROM sessions WHERE substr(started_at,1,10)=?",
                       (day.isoformat(),)).fetchone()[0]


def top(con, col: str, where: str, arg) -> str:
    r = con.execute("SELECT %s, SUM(cost_usd) c FROM sessions WHERE %s GROUP BY 1 ORDER BY c DESC, SUM(input_tokens + output_tokens) DESC LIMIT 1"
                    % (col, where), (arg,)).fetchone()
    return (r[0], r[1]) if r else ("none", 0.0)


def pct(part: float, whole: float) -> str:
    return "%d%%" % round(100 * part / whole) if whole else "0%"


def cmd_today(con, a):
    day = a.date or dt.date.today()
    spent, week = today_cost(con, day), iso_week(day)
    w = "substr(started_at,1,10)=?"
    n = con.execute("SELECT COUNT(DISTINCT session_id) FROM sessions WHERE " + w, (day.isoformat(),)).fetchone()[0]
    tm, tp = top(con, "model", w, day.isoformat()), top(con, "provider", w, day.isoformat())
    i, o, c = con.execute("SELECT COALESCE(SUM(input_tokens),0), COALESCE(SUM(output_tokens),0), "
                          "COALESCE(SUM(cache_hit_tokens),0) FROM sessions WHERE " + w, (day.isoformat(),)).fetchone()
    wk = con.execute("SELECT COALESCE(SUM(cost_usd),0) FROM sessions WHERE iso_week=? AND substr(started_at,1,10)<=?",
                     (week, day.isoformat())).fetchone()[0]
    pace = "on pace" if wk <= a.week_target * day.isoweekday() / 7 else "over pace"
    print("opencode cost dashboard | %s %s" % (week, day.strftime("%A")))
    print("─" * 45)
    print("today's run-rate:    $%.2f  (warning at $%.2f, cutoff $%.2f)" % (spent, a.warn, a.cutoff))
    print("session count:       %d" % n)
    print("top model:           %s  ($%.2f, %s of today)" % (tm[0], tm[1], pct(tm[1], spent)))
    print("top provider:        %s  ($%.2f, %s of today)" % (tp[0], tp[1], pct(tp[1], spent)))
    t = i + o + c
    print("token split:         input %s / output %s / cache read %s" % (pct(i, t), pct(o, t), pct(c, t)))
    print("this week so far:    $%.2f  (target $%.2f, %s)" % (wk, a.week_target, pace))


def cmd_report(con, a):
    week = a.week or iso_week(dt.date.today())
    rows = con.execute("SELECT * FROM sessions WHERE iso_week=?", (week,)).fetchall()
    total = sum(r["cost_usd"] for r in rows)
    sessions = {r["session_id"] for r in rows}
    out = ["# Week %s" % week, "", "Total spend: $%.2f" % total,
           "Daily average: $%.2f (target $%.2f)" % (total / 7, a.daily_target),
           "Sessions: %d" % len(sessions)]
    for title, col in (("By model", "model"), ("By agent", "agent"), ("By provider", "provider"),
                       ("By task class (manually tagged)", "task_class")):
        out += ["", title + ":"]
        sums = {}
        for r in rows:
            sums[r[col] or "untagged"] = sums.get(r[col] or "untagged", 0) + r["cost_usd"]
        out += ["- %-34s $%.2f (%s)" % (k, v, pct(v, total)) for k, v in sorted(sums.items(), key=lambda x: -x[1])]
    out += ["", "Anomalies:"]
    days = {}
    for r in rows:
        days[r["started_at"][:10]] = days.get(r["started_at"][:10], 0) + r["cost_usd"]
    found = False
    for d, v in sorted(days.items()):
        if v >= a.warn:
            found = True
            out += ["- %s cost $%.2f (warning at $%.2f)." % (dt.date.fromisoformat(d).strftime("%A %Y-%m-%d"), v, a.warn),
                    "  cause: " + UNKNOWN]
    per = {}
    for r in rows:
        per[r["session_id"]] = per.get(r["session_id"], 0) + r["input_tokens"]
    avg = sum(per.values()) / len(per) if per else 0
    for sid, n in sorted(per.items()):
        if len(per) > 1 and avg and n >= a.spike * avg:
            found = True
            out += ["- session '%s' input tokens %dK vs week average %dK (%.1fx)." % (sid, n // 1000, avg // 1000, n / avg),
                    "  cause: " + UNKNOWN]
    if not found:
        out.append("- none")
    path = Path(a.out) if a.out else REPORT_DIR / ("%s.md" % week)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(out) + "\n")
    print("\n".join(out))
    print("\nwrote %s" % path)


def cmd_alert(con, a):
    spent = today_cost(con, dt.date.today())
    if spent >= a.cutoff and a.cutoff_on:
        flag = Path(a.db).parent / "cooldown"
        flag.write_text("cost cooldown: $%.2f today (cutoff $%.2f), set %s\n"
                        "clear it with: cost-dash reset --reason \"...\"\n" % (spent, a.cutoff, stamp()))
        print("\aCUTOFF: $%.2f today, cutoff $%.2f. wrote %s" % (spent, a.cutoff, flag))
        return 2
    if spent >= a.warn:
        print("\aWARNING: $%.2f today, warning at $%.2f" % (spent, a.warn))
        return 1
    print("ok: $%.2f today (warning at $%.2f)" % (spent, a.warn))
    return 0


def cmd_reset(con, a):
    flag = Path(a.db).parent / "cooldown"
    was = flag.exists()
    if was:
        flag.unlink()
    with open(Path(a.db).parent / "resets.log", "a") as f:
        f.write("%s\t%s\t%s\n" % (stamp(), "cleared" if was else "no cooldown", a.reason))
    print("cooldown cleared" if was else "no cooldown was set", "| reason recorded:", a.reason)


def cmd_log(con, a):
    sid = a.session or a.export_session or (con.execute("SELECT session_id FROM sessions ORDER BY ended_at DESC LIMIT 1").fetchone() or [None])[0]
    rows = con.execute("SELECT * FROM sessions WHERE session_id=? ORDER BY started_at", (sid,)).fetchall()
    if not rows:
        sys.exit("cost-dash: no assistant messages for session %s" % sid)
    path = Path(a.csv)
    new = not path.exists() or path.stat().st_size == 0
    with open(path, "a", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        if new:
            w.writerow(["date", "project", "model", "input_tokens", "output_tokens", "cost_usd"])
        for r in rows:
            w.writerow([r["iso_week"], a.project, r["model"], r["input_tokens"], r["output_tokens"], "%.4f" % r["cost_usd"]])
            print("%-14s %-34s in %-8d out %-7d $%.4f" % (r["agent"], r["model"], r["input_tokens"], r["output_tokens"], r["cost_usd"]))
    secs = (dt.datetime.fromisoformat(max(r["ended_at"] for r in rows)) -
            dt.datetime.fromisoformat(min(r["started_at"] for r in rows))).total_seconds()
    print("session %s: %d row(s) appended to %s" % (sid, len(rows), path))
    print("duration: %dm %02ds (first message to last reply)" % (secs // 60, secs % 60))
    print("diff quality: " + UNKNOWN)


def cmd_tag(con, a):
    n = con.execute("UPDATE sessions SET task_class=? WHERE session_id=?", (a.task_class, a.session)).rowcount
    con.commit()
    print("tagged %d row(s) of %s as %s" % (n, a.session, a.task_class))


def main(argv=None) -> int:
    c = argparse.ArgumentParser(add_help=False)   # options every command takes
    c.add_argument("--opencode-db", default=str(OPENCODE_DB), help="opencode's own database, opened read-only (default %(default)s)")
    c.add_argument("--export", help="read one `opencode export <sessionID>` JSON file instead of the database")
    c.add_argument("--db", default=str(DB_PATH), help="the dashboard's store (default %(default)s)")
    c.add_argument("--warn", type=float, default=0.80, help="daily warning, dollars (default 0.80)")
    c.add_argument("--cutoff-at", dest="cutoff", type=float, default=1.50, help="daily hard cutoff, dollars (default 1.50)")
    c.add_argument("--daily-target", type=float, default=1.00, help="daily target, dollars (default 1.00)")
    c.add_argument("--week-target", type=float, default=7.00, help="weekly target, dollars (default 7.00)")
    p = argparse.ArgumentParser(prog="cost-dash", description="What your opencode sessions cost (chapter 9).")
    sub = p.add_subparsers(dest="cmd", required=True)
    t = sub.add_parser("today", parents=[c], help="today's run-rate, top model, top provider, week so far")
    t.add_argument("--date", type=dt.date.fromisoformat, help="another day, YYYY-MM-DD")
    r = sub.add_parser("report", parents=[c], help="weekly Markdown report")
    r.add_argument("--week", help="ISO week such as 2026-W19 (default this week)")
    r.add_argument("--out", help="file to write (default ~/Documents/opencode-weekly/<week>.md)")
    r.add_argument("--spike", type=float, default=3.0, help="flag a session with this many times the average input tokens")
    al = sub.add_parser("alert", parents=[c], help="for cron every 5 minutes; exits 1 at the warning")
    al.add_argument("--cutoff", dest="cutoff_on", action="store_true", help="also write the cooldown file at the cutoff")
    rs = sub.add_parser("reset", parents=[c], help="clear the cooldown file")
    rs.add_argument("--reason", required=True)
    lg = sub.add_parser("log", parents=[c], help="append one cost-log.csv row per agent and model of a session")
    lg.add_argument("--project", required=True)
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--session", help="session id (see `opencode session list`)")
    g.add_argument("--last", action="store_true", help="the session that ended last (the default)")
    lg.add_argument("--csv", default="cost-log.csv")
    tg = sub.add_parser("tag", parents=[c], help="set task_class on every row of a session")
    tg.add_argument("session")
    tg.add_argument("task_class", choices=["refactor", "greenfield", "debug"])
    a = p.parse_args(argv)
    con = open_store(a)
    try:
        return {"today": cmd_today, "report": cmd_report, "alert": cmd_alert, "reset": cmd_reset,
                "log": cmd_log, "tag": cmd_tag}[a.cmd](con, a) or 0
    finally:
        con.close()


if __name__ == "__main__":
    sys.exit(main())
